APP_NAME="Bank Sync"
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi
# Link to this deployment's source code (AGPL-3.0 requires offering it)
APP_SOURCE_URL=https://github.com/ninggiangboy/bank-sync

DATABASE_PATH=storage/bank-sync.sqlite
PORT=8000

# Outgoing mail for verification and password reset. Leave MAIL_HOST empty to log mail instead.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Bank Sync"

# Domain that receives forwarded bank emails through Cloudflare Email Routing
INBOUND_DOMAIN=in.example.com
# Shared HMAC secret with the inbound Email Worker, at least 32 characters
INBOUND_WEBHOOK_SECRET=
# Largest accepted forwarded email and history upload, in bytes
INBOUND_MAX_BYTES=2097152
UPLOAD_MAX_BYTES=52428800

# Fallback USD to VND rate until the daily exchange rates are downloaded
FX_USD_VND=26000

# Seeded account that signed-in users can view read-only
DEMO_USER_EMAIL=demo@example.com
# Load SimpleAnalytics (simpleanalytics.com) on every page
SIMPLE_ANALYTICS_ENABLED=false

# Session signing secret, at least 32 characters. Required in production.
BETTER_AUTH_SECRET=

# Run the job worker and the scheduler inside the server process
WORKER_ENABLED=true
SCHEDULER_ENABLED=true
